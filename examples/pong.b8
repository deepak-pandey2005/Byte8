// Classic Pong written in Byte8-C High-Level Language
sprite paddle = [ 0x80, 0x80, 0x80, 0x80, 0x80 ];
sprite ball = [ 0xC0, 0xC0 ];

byte p1_y = 12;
byte p2_y = 12;
byte ball_x = 31;
byte ball_y = 15;
byte ball_dx = 1;
byte ball_dy = 1;
byte score1 = 0;
byte score2 = 0;

void reset_ball() {
    ball_x = 31;
    ball_y = 15;
    sound_timer = 8;
}

void main() {
    cls();

    while (1) {
        cls();

        // Draw Scoreboard
        draw_font(20, 1, score1);
        draw_font(40, 1, score2);

        // Draw Paddles: P1 at X=2, P2 at X=61 (height 5)
        draw(2, p1_y, paddle, 5);
        draw(61, p2_y, paddle, 5);

        // Draw Ball (2x2)
        draw(ball_x, ball_y, ball, 2);

        // Player 1 Controls: Key 1 (Up) and Key 4 (Down)
        if (key_down(1)) {
            if (p1_y > 1) {
                p1_y -= 1;
            }
        }
        if (key_down(4)) {
            if (p1_y < 26) {
                p1_y += 1;
            }
        }

        // Player 2 / AI Tracking
        if (p2_y < ball_y) {
            if (p2_y < 26) {
                p2_y += 1;
            }
        } else {
            if (p2_y > 1) {
                p2_y -= 1;
            }
        }

        // Ball Horizontal Physics
        if (ball_dx == 1) {
            ball_x += 1;
            if (ball_x >= 59) {
                // Check right paddle collision
                if (ball_y >= p2_y) {
                    if (ball_y <= p2_y + 5) {
                        ball_dx = 0;
                        sound_timer = 2;
                    }
                }
                if (ball_x >= 62) {
                    score1 += 1;
                    ball_dx = 0;
                    reset_ball();
                }
            }
        } else {
            ball_x -= 1;
            if (ball_x <= 4) {
                // Check left paddle collision
                if (ball_y >= p1_y) {
                    if (ball_y <= p1_y + 5) {
                        ball_dx = 1;
                        sound_timer = 2;
                    }
                }
                if (ball_x <= 1) {
                    score2 += 1;
                    ball_dx = 1;
                    reset_ball();
                }
            }
        }

        // Ball Vertical Physics
        if (ball_dy == 1) {
            ball_y += 1;
            if (ball_y >= 30) {
                ball_dy = 0;
                sound_timer = 1;
            }
        } else {
            ball_y -= 1;
            if (ball_y <= 1) {
                ball_dy = 1;
                sound_timer = 1;
            }
        }

        // Synchronize frame with 60 FPS timer
        sync();
    }
}
